# Salin berkas ini menjadi .env di folder backend, lalu isi nilainya.
# Id client OAuth yang sama dengan VITE_GOOGLE_CLIENT_ID di frontend.
GOOGLE_CLIENT_ID=isi_client_id_apps.googleusercontent.com

# Rahasia penandatanganan sesi login pedagang; isi teks acak panjang.
AUTH_JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
