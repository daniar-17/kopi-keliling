# ID klien OAuth "Jenis aplikasi: Web" dari Google Cloud Console.
# Tambahkan origin (contoh http://localhost:5173 atau
# https://kopi-keliling.vercel.app) ke Authorized JavaScript origins klien
# tersebut. Salin file ini menjadi .env.local untuk dipakai.
VITE_GOOGLE_CLIENT_ID=isi_client_id_apps.googleusercontent.com

# Alamat backend. Kosongkan saat pengembangan supaya frontend otomatis
# memakai http://<hostname>:8080. Di Vercel, isi dengan alamat Render,
# contoh: https://kopi-keliling-api.onrender.com
VITE_API_BASE_URL=
